<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF7F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📅 My Appointments"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#087F8C"
            android:gravity="center"
            android:padding="15dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Upcoming Appointment"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#087F8C"
            android:layout_marginTop="25dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👨‍⚕️  Dr. Rahul Sharma\n\nSpecialization: General Physician\nDate: 15/10/2026\nTime: 10:30 AM\nStatus: Confirmed"
            android:textSize="17sp"
            android:padding="20dp"
            android:background="#FFFFFF"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/btnCancelAppointment"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="❌  Cancel Appointment"
            android:textSize="17sp"
            android:layout_marginTop="15dp"/>

    </LinearLayout>

</ScrollView>