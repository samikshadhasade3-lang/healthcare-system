<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF7F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👤 Patient Dashboard"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#087F8C"
            android:gravity="center"
            android:padding="15dp"/>

        <Button
            android:id="@+id/btnPatientProfile"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="👤  My Profile"
            android:textSize="17sp"
            android:layout_marginTop="15dp"/>

        <Button
            android:id="@+id/btnFindDoctor"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="👨‍⚕️  Find / Book Doctor"
            android:textSize="17sp"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/btnPatientAppointments"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="📅  My Appointments"
            android:textSize="17sp"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/btnMedicineReminder"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="💊  Medicine Reminder"
            android:textSize="17sp"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/btnLabTests"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="🧪  Lab Test Booking"
            android:textSize="17sp"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/btnMedicalReports"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="📋  Medical Reports"
            android:textSize="17sp"
            android:layout_marginTop="10dp"/>

    </LinearLayout>

</ScrollView>