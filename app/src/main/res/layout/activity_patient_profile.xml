<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#EAF7F7">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="👤 Patient Profile"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#087F8C"
        android:gravity="center"
        android:padding="15dp"/>

    <EditText
        android:id="@+id/edtPatientName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Full Name"
        android:inputType="textPersonName"
        android:layout_marginTop="20dp"/>

    <EditText
        android:id="@+id/edtPatientEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Email"
        android:inputType="textEmailAddress"
        android:layout_marginTop="10dp"/>

    <EditText
        android:id="@+id/edtPatientMobile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Mobile Number"
        android:inputType="phone"
        android:layout_marginTop="10dp"/>

    <EditText
        android:id="@+id/edtPatientAge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Age"
        android:inputType="number"
        android:layout_marginTop="10dp"/>

    <EditText
        android:id="@+id/edtPatientAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Address"
        android:inputType="textPostalAddress"
        android:layout_marginTop="10dp"/>

    <Button
        android:id="@+id/btnSavePatientProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💾  Save Profile"
        android:textSize="17sp"
        android:layout_marginTop="20dp"/>

</LinearLayout>