<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF7F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👨‍⚕️ Find / Book Doctor"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#087F8C"
            android:gravity="center"
            android:padding="15dp"/>

        <EditText
            android:id="@+id/edtDoctorName"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Search Doctor"
            android:inputType="text"
            android:layout_marginTop="15dp"/>

        <EditText
            android:id="@+id/edtSpecialization"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Specialization"
            android:inputType="text"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/btnSearchDoctor"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="🔍  Search Doctor"
            android:textSize="17sp"
            android:layout_marginTop="15dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Available Doctors"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#087F8C"
            android:layout_marginTop="25dp"/>

        <Button
            android:id="@+id/btnDoctor1"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="👨‍⚕️  Dr. Rahul Sharma\n     General Physician"
            android:textSize="16sp"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/btnDoctor2"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="👩‍⚕️  Dr. Priya Patil\n     Cardiologist"
            android:textSize="16sp"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/btnDoctor3"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="👨‍⚕️  Dr. Amit Joshi\n     Dermatologist"
            android:textSize="16sp"
            android:layout_marginTop="10dp"/>

    </LinearLayout>

</ScrollView>