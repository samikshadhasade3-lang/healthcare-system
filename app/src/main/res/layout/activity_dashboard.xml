<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF7F7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <Space
            android:layout_width="match_parent"
            android:layout_height="45dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Healthcare &amp; Medicine"
            android:textSize="27sp"
            android:textStyle="bold"
            android:textColor="#087F8C"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose Your Role"
            android:textSize="17sp"
            android:textColor="#607D82"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="35dp" />

        <!-- Doctor -->
        <Button
            android:id="@+id/btnDoctor"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="👨‍⚕️   Doctor"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#087F8C"
            android:elevation="6dp"
            android:layout_marginBottom="18dp" />

        <!-- Patient -->
        <Button
            android:id="@+id/btnPatient"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="👤   Patient"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#159A9C"
            android:elevation="6dp"
            android:layout_marginBottom="18dp" />

        <!-- Laboratory -->
        <Button
            android:id="@+id/btnLaboratory"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="🧪   Laboratory"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#117A8B"
            android:elevation="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select an option to continue"
            android:textSize="13sp"
            android:textColor="#78909C"
            android:layout_marginTop="30dp" />

    </LinearLayout>

</ScrollView>